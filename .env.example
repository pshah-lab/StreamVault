# StreamVault Environment Configuration Example
# Copy this file to .env on your local machine and fill in your values.

# AWS Credentials & Profile
AWS_PROFILE=default
AWS_REGION=us-east-1

# S3 Storage & CloudFront Distribution
BUCKET=your-s3-bucket-name
DISTRIBUTION_ID=YOUR_CLOUDFRONT_DISTRIBUTION_ID
VIEWER_DOMAIN=your-domain.cloudfront.net

# Cognito Authentication (used by FastAPI backend)
# These must match the Cognito User Pool created by the CDK stack (infra/lib/video-auth-stack.ts).
# You can find these values in the CDK stack outputs or the AWS Cognito console.
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REGION=us-east-1

# Optional Infrastructure Overrides
USER_POOL_NAME=streamvault-user-pool
DYNAMODB_TABLE_NAME=StreamVaultPlayback
EC2_INSTANCE_PROFILE_NAME=hls-video-chunker-ec2-worker

# ── Production Secret Management ──
# For production deployments, use AWS Parameter Store / Secrets Manager instead of .env:
#   export AWS_ACCESS_KEY_ID=$(aws ssm get-parameter --name "/streamvault/aws-key" --with-decryption --query "Parameter.Value" --output text)
# Then run the backend with: uvicorn main:app --host 0.0.0.0 --port 8000
